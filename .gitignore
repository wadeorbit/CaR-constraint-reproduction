# Python bytecode caches
__pycache__/
*.py[cod]

# Generated training and smoke-test outputs
/results/

# Refinement rerun intermediates duplicated by the combined log
/reproduction_runs/TSPTW50_hard_CaR_POMO/refinement_*/*.stdout.log
/reproduction_runs/TSPTW50_hard_CaR_POMO/refinement_*/*.stderr.log
/reproduction_runs/TSPTW50_hard_CaR_POMO/refinement_*/command.txt
/reproduction_runs/TSPTW50_hard_CaR_POMO/refinement_*/result.json

# The same duplicate intermediates from isolated refinement reruns
/reproduction_runs/TSPTW50_hard_CaR_POMO/reruns/**/*.stdout.log
/reproduction_runs/TSPTW50_hard_CaR_POMO/reruns/**/*.stderr.log
/reproduction_runs/TSPTW50_hard_CaR_POMO/reruns/**/command.txt
/reproduction_runs/TSPTW50_hard_CaR_POMO/reruns/**/result.json
